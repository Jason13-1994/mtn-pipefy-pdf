# nginx.conf.example -- mtn-pipefy-pdf
#
# THIS FILE IS COMMITTED. Copy it to /etc/nginx/sites-available/mtn-pipefy-pdf
# on the box, set server_name below to your real hostname, symlink into
# sites-enabled, then run Certbot -- it rewrites this file in place to add the
# TLS server block and certificate lines. Ships the same way segredo.ini.example
# does: a real, adaptable file in the repo. Unlike segredo.ini, there is no
# gitignored secret counterpart here -- this file carries no credential, only
# proxy and rate-limit configuration, so it is never re-committed with a
# "real" value the way segredo.ini.example's blank keys are.

# limit_req_zone must live in the `http {}` context. Ubuntu's stock
# /etc/nginx/nginx.conf includes both conf.d/*.conf and sites-enabled/* from
# inside its own http {} block, so declaring the zone here -- above the
# server {} block, in a file that ends up included from sites-enabled -- is
# valid. `sudo nginx -t` (already step 4 of SERVER_SETUP.md) is the actual
# proof; if this layout is ever wrong for a given box, that command catches
# it before reload, not after.
limit_req_zone $binary_remote_addr zone=mtn_pdf_gen:10m rate=1r/s;

server {
    listen 80;
    server_name <your-hostname-here>;    # e.g. mtn-pdf.dydx.digital -- Certbot adds :443 for you

    # The only body Nginx should ever pass through here is a single small
    # JSON webhook payload -- {"data":{"card":{"id":"..."}}} or
    # {"card_id":...}, realistically under 500 bytes. 16k is ~30x that with
    # room to spare, and rejects anything shaped like a file upload before it
    # reaches uvicorn at all. main.py itself only enforces a lower bound
    # (len(body) < 3), no upper bound -- this cap belongs at the Nginx tier.
    client_max_body_size 16k;

    location /generate-pdf {
        # Coarse, deliberately: real traffic is a Pipefy automation firing on
        # human-paced approvals (tens/day) plus occasional manual retriggers.
        # 1 req/s sustained with a burst of 5 absorbed immediately (nodelay)
        # comfortably exceeds any real usage while still blocking a runaway
        # retry loop or basic abuse.
        limit_req zone=mtn_pdf_gen burst=5 nodelay;
        # Explicit 429 (not the bare-module default 503) so a throttled
        # request is distinguishable in logs/alerts from "the app is down" --
        # this is an operator-facing log/alert clarity choice, not a claim
        # about whether Pipefy retries on either code (unconfirmed either way
        # -- see SERVER_SETUP.md section 8's alerting note).
        limit_req_status 429;

        proxy_pass http://127.0.0.1:5040;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # main.py returns HTTP 200 almost immediately (auth + parse +
        # idempotency claim only) and hands the actual render/attach work to
        # a BackgroundTasks worker that runs AFTER this response is sent --
        # this timeout is NOT how long PDF generation is allowed to take.
        # Kept at 120s (matches the pre-existing template value and
        # comfortably exceeds uvicorn's own --timeout-keep-alive 90) rather
        # than tuned tight.
        proxy_read_timeout 120s;
    }

    location / {
        # /hello (polled by an uptime monitor per SERVER_SETUP.md section 8)
        # and everything else. Deliberately NOT behind limit_req -- the
        # monitor polls it on its own schedule and it does no work worth
        # throttling.
        proxy_pass http://127.0.0.1:5040;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
